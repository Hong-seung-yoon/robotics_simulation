+def eef_to_object_in_base_frame(
+    env: ManagerBasedRLEnv,
+    object_cfg: SceneEntityCfg = SceneEntityCfg("toy_truck"),
+    ee_frame_cfg: SceneEntityCfg = SceneEntityCfg("ee_frame"),
+    robot_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+) -> torch.Tensor:
+    """Vector from the end effector to the object, in the robot base frame (object_pos - eef_pos)."""
+    ee_frame: FrameTransformer = env.scene[ee_frame_cfg.name]
+    robot: Articulation = env.scene[robot_cfg.name]
+    ee_pos_base, _ = math_utils.subtract_frame_transforms(
+        robot.data.root_pos_w, robot.data.root_quat_w, ee_frame.data.target_pos_w[:, 0, :], ee_frame.data.target_quat_w[:, 0, :]
+    )
+    return object_poses_in_base_frame(env, object_cfg, robot_cfg, return_key="pos") - ee_pos_base
+
+
+def object_to_object_in_base_frame(
+    env: ManagerBasedRLEnv,
+    from_cfg: SceneEntityCfg = SceneEntityCfg("toy_truck"),
+    to_cfg: SceneEntityCfg = SceneEntityCfg("box"),
+    robot_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+) -> torch.Tensor:
+    """Vector from one object to another, in the robot base frame (to_pos - from_pos)."""
+    return object_poses_in_base_frame(env, to_cfg, robot_cfg, return_key="pos") - object_poses_in_base_frame(
+        env, from_cfg, robot_cfg, return_key="pos"
+    )
